{
  "name": "humanity-tech-tree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:compile && npm run validate:data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "data:compile": "node scripts/compile-data.mjs",
    "data:enrich": "node scripts/enrich-wikipedia.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
